#!/usr/bin/env bash
# Usage: claude-remote [--root DIR] [--name NAME] [--config-dir DIR | --account NAME | --burst] [--with NAMES] [--server [--spawn MODE]] [--trust] [--install-boot | --uninstall-boot] <repo-name | /full/path>
set -euo pipefail

root="${CLAUDE_REMOTE_ROOT:-$HOME/Workspace}"
settings="${CLAUDE_REMOTE_SETTINGS:-}"
config_dir="${CLAUDE_CONFIG_DIR:-}"
target=""; rc_name=""; trust=0; boot=""; server=0; spawn=""; account=""; with=""; usage_flags="[--root DIR] [--name NAME] [--config-dir DIR | --account NAME | --burst] [--with NAMES] [--server [--spawn MODE]] [--trust] [--install-boot | --uninstall-boot]"

while (( $# )); do
  case "$1" in
    --root) root="${2:?--root needs a directory}"; shift 2 ;;
    --config-dir) config_dir="${2:?--config-dir needs a directory}"; config_dir_given=1; shift 2 ;;
    --account) account="${2:?--account needs a name}"; shift 2 ;;
    --burst) account=burst; shift ;;
    --with) with="${2:?--with needs a comma-separated list}"; shift 2 ;;
    --name) rc_name="${2:?--name needs a value}"; shift 2 ;;
    --server) server=1; shift ;;
    --spawn) spawn="${2:?--spawn needs a mode}"; shift 2 ;;
    --trust) trust=1; shift ;;
    --install-boot) boot=install; shift ;;
    --uninstall-boot) boot=uninstall; shift ;;
    -h|--help) sed -n '2p' "$0" | cut -c3-; exit 0 ;;
    *) target="$1"; shift ;;
  esac
done
[[ -n "$target" ]] || { echo "usage: claude-remote $usage_flags <repo-name | /full/path>" >&2; exit 64; }
[[ -z "$account" || "$account" =~ ^[a-z0-9_-]+$ ]] || { echo "--account may only contain lowercase letters, digits, '_' and '-'" >&2; exit 64; }
[[ -z "$with" || "$with" =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]] || { echo "--with needs names (letters, digits, '_', '-') separated by commas" >&2; exit 64; }
[[ -z "$account" || -z "${config_dir_given:-}" ]] || { echo "--account/--burst and --config-dir are mutually exclusive" >&2; exit 64; }
[[ -z "$account" ]] || config_dir=
case "$spawn" in
  ""|same-dir|worktree|session) ;;
  *) echo "--spawn must be same-dir, worktree or session" >&2; exit 64 ;;
esac
[[ -z "$spawn" ]] || (( server )) || { echo "--spawn needs --server" >&2; exit 64; }

root="${root/#\~/$HOME}"
config_dir="${config_dir/#\~/$HOME}"
[[ "$config_dir" != *$'\n'* && "$config_dir" != *$'\r'* ]] || { echo "config dir contains a line break" >&2; exit 64; }
[[ -z "$config_dir" ]] || config_dir="$(realpath -m -s "$config_dir")"
[[ -z "$config_dir" || "$boot" == uninstall || -d "$config_dir" ]] \
  || { echo "config dir not found: $config_dir" >&2; exit 66; }
target="${target/#\~/$HOME}"

resolve_path() {
  [[ -d "$target" ]] || { echo "not a directory: $target" >&2; exit 1; }
  realpath "$target"
}

resolve_name() {
  [[ -d "$root" ]] || { echo "root not found: $root" >&2; exit 1; }
  local repos exact fuzzy
  mapfile -t repos < <(find -H "$root" -maxdepth 3 -name .git -prune -printf '%h\n' | sort)
  exact=(); fuzzy=()
  for r in "${repos[@]}"; do
    local base="${r##*/}"
    [[ "${base,,}" == "${target,,}" ]] && exact+=("$r")
    [[ "${base,,}" == *"${target,,}"* ]] && fuzzy+=("$r")
  done
  local matches=("${exact[@]}")
  (( ${#matches[@]} )) || matches=("${fuzzy[@]}")
  case ${#matches[@]} in
    0) echo "no git repo matches '$target' under $root" >&2; exit 1 ;;
    1) realpath "${matches[0]}" ;;
    *) echo "ambiguous '$target':" >&2; printf '  %s\n' "${matches[@]}" >&2; exit 2 ;;
  esac
}

# Matches literal Claude Code TUI text ("trust this folder", "❯ Yes"; the server's "Trust <dir>? [y/N]", "Connected"); update if the wording changes.
accept_trust() {
  local i pane
  for ((i = 0; i < 20; i++)); do
    pane="$(tmux capture-pane -t "$session" -p 2>/dev/null || true)"
    if (( server )); then
      if [[ "$pane" == *"Trust "*"[y/N]"* ]]; then tmux send-keys -t "$session" y Enter; return 0; fi
      [[ "$pane" == *"Connected"* ]] && return 0
    fi
    if [[ "$pane" == *"trust this folder"* ]]; then
      if [[ "$pane" == *"❯ Yes"* ]]; then tmux send-keys -t "$session" Enter
      else tmux send-keys -t "$session" Down Enter; fi
      return 0
    fi
    [[ "$pane" == *"remote-control is active"* ]] && return 0
    sleep 1
  done
}

sd_quote() {
  local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//%/%%}"
  printf '"%s"' "$s"
}

find_helper() {
  local helper
  for helper in "$(command -v "$1" || true)" "$HOME/.dotfiles/bin/$1"; do
    [[ -n "$helper" && -x "$helper" ]] && { realpath -s -- "$helper"; return 0; }
  done
  return 0
}

unit_path() { echo "$HOME/.config/systemd/user/claude-remote-${session#claude-}.service"; }

install_boot() {
  local unit exec_args=(--name "$name") bin="$HOME/.local/share/claude-remote/claude-remote"
  unit="$(unit_path)"
  mkdir -p "${bin%/*}"
  # The unit runs a copy outside the versioned plugin cache so plugin updates cannot break it.
  install -m 755 "$(realpath "$0")" "$bin"
  (( server )) && exec_args+=(--server)
  [[ -z "$spawn" ]] || exec_args+=(--spawn "$spawn")
  (( trust )) && exec_args+=(--trust)
  [[ -n "$config_dir" ]] && exec_args+=(--config-dir "$config_dir")
  [[ -z "$account" ]] || exec_args+=(--account "$account")
  [[ -z "$with" ]] || exec_args+=(--with "$with")
  exec_args+=("$path")
  local unset_line=""
  [[ -n "$config_dir" ]] || unset_line=$'UnsetEnvironment=CLAUDE_CONFIG_DIR\n'
  mkdir -p "${unit%/*}"
  {
    printf '[Unit]\nDescription=Claude remote-control %s %s\nAfter=network-online.target\nWants=network-online.target\n\n' "$kind" "$name"
    printf '[Service]\nType=oneshot\nRemainAfterExit=yes\nKillMode=process\nTimeoutStartSec=300\nRestart=on-failure\nRestartSec=30\n'
    printf 'Environment=%s\n' "$(sd_quote "PATH=$PATH")"
    [[ -z "$settings" ]] || printf 'Environment=%s\n' "$(sd_quote "CLAUDE_REMOTE_SETTINGS=$settings")"
    # Without the wait, Remote Control fails session creation at boot: the link gains carrier before DNS works.
    printf 'ExecStartPre=/usr/bin/env curl -s --retry 30 --retry-delay 2 --retry-all-errors --max-time 5 -o /dev/null https://api.anthropic.com\n'
    printf '%s' "$unset_line"
    printf 'ExecStart=%s' "$(sd_quote "${bin//\$/\$\$}")"
    for a in "${exec_args[@]}"; do printf ' %s' "$(sd_quote "${a//\$/\$\$}")"; done
    printf '\n\n[Install]\nWantedBy=default.target\n'
  } > "$unit"
  # Without linger the user manager, and this unit, only start at login.
  loginctl enable-linger "$USER"
  systemctl --user daemon-reload
  systemctl --user enable --now "${unit##*/}"
  echo "installed ${unit##*/} (linger enabled)"
  local legacy; legacy="claude-remote-${name//[^A-Za-z0-9_-]/_}-$(printf %s "$path" | sha1sum | cut -c1-6).service"
  (( server )) || [[ -z "$config_dir" || "$legacy" == "${unit##*/}" ]] || ! systemctl --user is-enabled --quiet "$legacy" 2>/dev/null \
    || echo "warning: legacy unit $legacy is still enabled and starts a duplicate session; remove it with 'env -u CLAUDE_CONFIG_DIR claude-remote --uninstall-boot ...'" >&2
}

uninstall_boot() {
  local unit; unit="$(unit_path)"
  systemctl --user disable --now "${unit##*/}" 2>/dev/null || true
  rm -f "$unit"
  systemctl --user daemon-reload
  echo "removed ${unit##*/}; tmux session $session left running"
}

if [[ "$target" == */* || "$target" == . || "$target" == .. ]]; then
  path="$(resolve_path)"
else
  path="$(resolve_name)"
fi

name="${rc_name:-${path##*/}}"
[[ "$name$path" != *$'\n'* && "$name$path" != *$'\r'* ]] || { echo "name or path contains a line break" >&2; exit 64; }
[[ -z "$rc_name" || "$rc_name" == "${rc_name//[^A-Za-z0-9_-]/_}" ]] \
  || { echo "--name may only contain letters, digits, '_' and '-'" >&2; exit 64; }
kind=session; suffix=""
if (( server )); then kind=server; suffix="-server"; fi
hash="$(printf %s "$path${config_dir:+$'\n'$config_dir}${account:+$'\n'account=$account}${with:+$'\n'with=$with}${suffix:+$'\n'server}" | sha1sum | cut -c1-6)"
session="claude-${name//[^A-Za-z0-9_-]/_}$suffix-$hash"

case "$boot" in
  install) install_boot; exit 0 ;;
  uninstall) uninstall_boot; exit 0 ;;
esac

if tmux has-session -t "$session" 2>/dev/null; then
  echo "reusing session $session"
else
  args=(env)
  if [[ -n "$config_dir" ]]; then args+=("CLAUDE_CONFIG_DIR=$config_dir"); else args+=(-u CLAUDE_CONFIG_DIR); fi
  # claude-env-load exports ~/.config/dotfiles/secrets.env; tmux panes never read the shell profile.
  env_load="$(find_helper claude-env-load)"
  if [[ -n "$env_load" ]]; then
    # claude-env-load turns this into the account's OTel env; an unrecognised config dir gets none.
    config_base="${config_dir##*/}"
    if [[ -z "$config_dir" ]]; then otel_account=main
    elif [[ "$config_base" == .claude-?* ]]; then otel_account="${config_base#.claude-}"
    else otel_account=
    fi
    [[ -z "$otel_account" ]] || args+=("CLAUDE_OTEL_ACCOUNT=$otel_account")
    args+=("$env_load")
  fi
  # With --account or --with, claude runs in an interactive zsh so the user's claude function applies the account's API key, OTel env and --with.
  claude_cmd=(claude)
  if [[ -n "$account" || -n "$with" ]]; then
    claude_cmd=(zsh -ic 'claude "$@"' claude)
    [[ -z "$account" ]] || claude_cmd+=(--account "$account")
    [[ -z "$with" ]] || claude_cmd+=(--with "$with")
  fi
  # The server has no single conversation to resume, so it runs without the loop.
  if (( server )); then
    args+=("${claude_cmd[@]}" remote-control --name "$name")
    [[ -z "$spawn" ]] || args+=(--spawn "$spawn")
  else
    # The loop keeps the pane after claude exits so Cozempic's typed resume line restarts it; env stays outside
    # it so the resumed claude keeps the account.
    loop="$(find_helper claude-pane-loop)"
    [[ -z "$loop" ]] || args+=("$loop")
    args+=("${claude_cmd[@]}" --remote-control "$name")
  fi
  [[ -n "$settings" && -f "$settings" ]] && args+=(--settings "$settings")
  tmux new-session -d -s "$session" -c "$path" "$(printf '%q ' "${args[@]}")"
  echo "started session $session"
  (( trust )) && accept_trust
fi

echo "repo:   $path"
printf 'attach: tmux attach -t %q\n' "$session"
